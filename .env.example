# Copy to `.env` and replace the placeholders. Never commit `.env`.
# Every variable the platform reads is listed here with a placeholder value.

# --- Optional: xeno-canto API v3 key ---------------------------------------
# Only needed to build the optional replay corpus of Creative Commons
# recordings. Get a key from your xeno-canto account page.
XENO_CANTO_API_KEY=your-xeno-canto-api-key

# --- Object storage (SeaweedFS S3 gateway in docker compose) ---------------
AVISCAPE_S3_ENDPOINT=http://localhost:8333
AVISCAPE_S3_ACCESS_KEY=change-me
AVISCAPE_S3_SECRET_KEY=change-me
AVISCAPE_S3_BUCKET=aviscape-lake

# --- PostgreSQL (DuckLake catalog) ----------------------------------------
AVISCAPE_PG_HOST=localhost
AVISCAPE_PG_PORT=5432
AVISCAPE_PG_DATABASE=aviscape_catalog
AVISCAPE_PG_USER=aviscape
AVISCAPE_PG_PASSWORD=change-me

# --- Kafka and schema registry --------------------------------------------
AVISCAPE_KAFKA_BOOTSTRAP=localhost:9092
AVISCAPE_SCHEMA_REGISTRY_URL=http://localhost:8081

# --- Budgets ----------------------------------------------------------------
# Hard cap for everything at rest (lake objects + catalog + topic logs).
AVISCAPE_STORAGE_BUDGET_BYTES=2147483648
# Maximum number of live streams listened to at the same time.
AVISCAPE_MAX_LIVE_STREAMS=5
